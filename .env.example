NODE_ENV=development
PORT=5001
JWT_SECRET=bloodconnect_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Database — SQLite (default, works without any MySQL installation)
DB_TYPE=sqlite
SQLITE_PATH=./data/bloodconnect.db

# Database — MySQL (uncomment and fill to use MySQL instead)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=bloodconnect

CLIENT_URL=http://localhost:5173
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
